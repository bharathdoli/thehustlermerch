// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"

}


// ─────────────────────────────────────────────────────────────────────────
// Custom Merch Store (caps / t-shirts / shirts / cups / hoodies) — Prisma schema
// Single-admin model: no Employee, PrintJob, ProductionStage, JobStageHistory,
// or Material — those existed to coordinate multiple people, which this
// business doesn't have yet. Extend later by adding new tables/nullable
// columns, not by rewriting what's here.
// ─────────────────────────────────────────────────────────────────────────

// ── Enums ───────────────────────────────────────────────────────────────

enum UserRole {
  Customer
  Admin

  @@map("user_role")
}

enum OrderStatus {
  pending           // order placed, payment not yet confirmed
  paymentConfirmed  // admin manually verified payment (or gateway confirmed, later)
  processing        // admin is printing/customizing and packing
  shipped
  delivered
  cancelled

  @@map("order_status")
}

enum PaymentStatus {
  initiated
  paid
  failed
  refunded

  @@map("payment_status")
}

// NEW — discount type for coupons
enum DiscountType {
  Percentage
  Flat

  @@map("discount_type")
}

// ── 1. User ─────────────────────────────────────────────────────────────

model User {
  uid       String   @id @default(uuid()) @db.Uuid
  uname     String
  email     String   @unique
  password  String?
  phoneNo   String   @unique
  role      UserRole @default(Customer)
  createdAt DateTime @default(now())

  addresses Address[]
  carts     Cart[]
  items     Item[]
  orders    Order[]   // NEW — Order now points directly to User (no more via Cart)
  reviews   Reviews[]

  @@map("User")
}

// ── 2. Address ──────────────────────────────────────────────────────────
// Unchanged. This is the customer's saved address book — at checkout, the
// chosen address gets COPIED into Order's shipping* fields (see below),
// so editing/deleting a saved address never alters a past order.

model Address {
  addressId    String  @id @default(uuid()) @db.Uuid
  userId       String  @db.Uuid
  recipientName  String  // NEW
  recipientPhone String  // NEW
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  pincode      String
  country      String  @default("India")
  isDefault    Boolean @default(false)

  user User @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@index([userId])
  @@map("Address")
}

// ── 3. Category ─────────────────────────────────────────────────────────
// Unchanged.

model Category {
  categoryId   String  @id @default(uuid()) @db.Uuid
  categoryName String
  description  String?
  imageUrl     String?

  products Product[]

  @@map("Category")
}

// ── 4. Product ──────────────────────────────────────────────────────────
// Unchanged.

model Product {
  productId    String   @id @default(uuid()) @db.Uuid
  categoryId   String?  @db.Uuid
  productName  String
  description  String?
  productImage String?
  rating       Decimal  @default(0) @db.Decimal(2, 1)
  reviewCount  Int      @default(0)
  createdAt    DateTime @default(now())

  category Category?        @relation(fields: [categoryId], references: [categoryId], onDelete: SetNull)
  variants ProductVariant[]
  reviews  Reviews[]

  @@index([categoryId])
  @@unique([categoryId, productName])
  @@map("Product")
}

// ── 5. ProductVariant ───────────────────────────────────────────────────
// NEW: stockQuantity. This IS your inventory system now — a blank cap or
// hoodie before customization isn't a separate "Material," it's just this
// row. One number, decremented when an order is confirmed, nothing to
// keep in sync across two systems.

model ProductVariant {
  variantId     String  @id @default(uuid()) @db.Uuid
  productId     String  @db.Uuid
  colour        String?
  size          String?
  price         Decimal @db.Decimal(10, 2)
  stockQuantity Int     @default(0) // NEW

  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)
  items   Item[]

  @@index([productId])
  @@map("ProductVariant")
}

// ── 6. Item ─────────────────────────────────────────────────────────────
// REDESIGNED: cartId / orderId are now real, nullable FKs instead of
// Cart.itemIds being a JSON array. An Item is created with cartId set and
// orderId null while it's in a cart; at checkout, orderId gets set (and
// cartId can be cleared or left as provenance — your call at the service
// layer). The database now enforces this relationship; no orphaned IDs
// possible.

model Item {
  itemId                 String   @id @default(uuid()) @db.Uuid
  userId                 String?  @db.Uuid
  cartId                 String?  @db.Uuid // NEW
  orderId                String?  @db.Uuid // NEW
  variantId              String   @db.Uuid
  customizationLogoFront String?
  customizationLogoBack  String?
  unitPrice              Decimal  @db.Decimal(10, 2) // frozen at time of adding
  quantity                Int     @default(1)
  createdAt               DateTime @default(now())

  user    User?          @relation(fields: [userId], references: [uid], onDelete: Cascade)
  cart    Cart?          @relation(fields: [cartId], references: [cartId], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [variantId])

  @@index([userId])
  @@index([cartId])
  @@index([orderId])
  @@index([variantId])
  @@map("Item")
}

// ── 7. Cart ─────────────────────────────────────────────────────────────
// REDESIGNED: no more itemIds Json array. Cart now owns its Items through
// a real relation. No orders relation anymore — see Order below for why.

model Cart {
  cartId    String   @id @default(uuid()) @db.Uuid
  userId    String?  @unique @db.Uuid 
  sessionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user  User?  @relation(fields: [userId], references: [uid], onDelete: Cascade)
  items Item[]

  @@index([userId])
  @@map("Cart")
}

// ── 8. Order ────────────────────────────────────────────────────────────
// REDESIGNED, several changes:
//   - No more cartId. Order owns its Items directly (Item.orderId) — once
//     placed, an order has zero runtime dependency on the cart that
//     produced it. Genuine decoupling, not just moving the same coupling
//     elsewhere.
//   - userId is now direct and required (checkout requires an account).
//     onDelete: Restrict — same reasoning as Payment below: a user being
//     removed should never silently erase order history.
//   - shipping* fields are a SNAPSHOT of the chosen Address at checkout
//     time, not a live FK — same "freeze it" principle as Item.unitPrice.
//     Editing a saved Address later must never rewrite a past order's
//     shipping details.
//   - subtotal / discountAmount / shippingCost / totalAmount are all
//     stored explicitly rather than derived on the fly, so an order's
//     final bill never silently changes if a coupon or product record
//     changes later.
//   - couponId is nullable and SetNull on delete — losing the coupon
//     reference never loses the discount that was already applied.
//   - trackingId / courierName are plain nullable strings: manual
//     shipping for now, same "hold it manual" approach as Payment.

model Order {
  orderId     String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  status      OrderStatus @default(pending)

  subtotal       Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  shippingCost   Decimal @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(10, 2)

  couponId String? @db.Uuid

  shippingName         String
  shippingPhone        String
  shippingAddressLine1 String
  shippingAddressLine2 String?
  shippingCity         String
  shippingState        String
  shippingPincode      String
  shippingCountry      String  @default("India")

  trackingId  String?
  courierName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user       User             @relation(fields: [userId], references: [uid], onDelete: Restrict)
  coupon     Coupon?          @relation(fields: [couponId], references: [couponId], onDelete: SetNull)
  items      Item[]
  payments   Payment[]
  reviews    Reviews[]
  statusLogs OrderStatusLog[]

  @@index([userId])
  @@index([couponId])
  @@map("Order")
}

// ── 9. Payment ──────────────────────────────────────────────────────────
// Unchanged shape. paymentMode/gatewayTxnId stay generic strings — Rajesh
// marking a manual UPI/cash payment paid today, and wiring in Razorpay
// later, are both just filling in the same fields.

model Payment {
  paymentId    String        @id @default(uuid()) @db.Uuid
  orderId      String        @db.Uuid
  paymentMode  String?
  gatewayTxnId String?
  status       PaymentStatus @default(initiated)
  amount       Decimal       @db.Decimal(10, 2)
  createdAt    DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [orderId], onDelete: Restrict)

  @@index([orderId])
  @@map("Payment")
}

// ── 10. Coupon (NEW) ────────────────────────────────────────────────────

model Coupon {
  couponId          String       @id @default(uuid()) @db.Uuid
  code              String       @unique
  type              DiscountType
  value             Decimal      @db.Decimal(10, 2) // % if Percentage, ₹ if Flat
  minOrderAmount    Decimal?     @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @db.Decimal(10, 2) // caps a Percentage discount
  validFrom         DateTime?
  validUntil        DateTime?
  usageLimit        Int?
  usageCount        Int          @default(0)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())

  orders Order[]

  @@map("Coupon")
}

// ── 11. OrderStatusLog (NEW) ────────────────────────────────────────────
// Lightweight, generic, no employee tie-in — just enough to render the
// "Order Placed → Payment Confirmed → Processing → Shipped" timeline for
// the customer. Nothing here needs to change if you later add staff.

model OrderStatusLog {
  historyId String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  status    OrderStatus
  note      String?
  changedAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@index([orderId])
  @@map("OrderStatusLog")
}

// ── 12. Reviews ─────────────────────────────────────────────────────────
// Unchanged.

model Reviews {
  rid       String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  userId    String?  @db.Uuid
  orderId   String?  @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [uid], onDelete: SetNull)
  order   Order?  @relation(fields: [orderId], references: [orderId])

  @@index([productId])
  @@map("Reviews")
}

// ─────────────────────────────────────────────────────────────────────────
// Apply via raw SQL / migration after `prisma migrate dev`:
//
// 1. CHECK constraint: rating between 1 and 5 on Reviews.
// 2. Trigger to keep Product.rating / reviewCount in sync on Reviews
//    insert/update/delete.
// 3. Application-layer (or trigger): decrement ProductVariant.stockQuantity
//    when an Order moves to paymentConfirmed; raise a low-stock signal
//    when stockQuantity drops below a threshold you define at the app
//    layer (no separate low-stock table needed for a single-admin shop —
//    a simple query `WHERE stockQuantity < N` on the admin dashboard is
//    enough; add a real threshold column later only if it needs to vary
//    per variant).
// ─────────────────────────────────────────────────────────────────────────
