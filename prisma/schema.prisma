// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  
}


// ─────────────────────────────────────────────────────────────────────────
// Printing Press — Prisma schema
// Base: Corporate Gifting E-Commerce schema (DB Design v6)
// Added: Employee, PrintJob, JobStageHistory, Material, MaterialUsage
// Target: PostgreSQL / Supabase
// ─────────────────────────────────────────────────────────────────────────


// ── Enums ───────────────────────────────────────────────────────────────

enum UserRole {
  Customer
  Admin
  Employee // NEW — lets an Employee log in through the same auth flow

  @@map("user_role")
}

enum OrderStatus {
  pending
  confirmed
  shipped
  delivered
  cancelled

  @@map("order_status")
}

enum PaymentStatus {
  initiated
  paid
  failed
  refunded

  @@map("payment_status")
}

// NEW — production pipeline stages a PrintJob moves through
enum ProductionStage {
  DesignReview
  Prepress
  Printing
  QualityCheck
  Dispatch
  Completed
  OnHold

  @@map("production_stage")
}

// NEW — which team an employee belongs to; also doubles as job routing
enum EmployeeDepartment {
  Design
  Prepress
  Printing
  QualityCheck
  Dispatch
  Inventory
  General

  @@map("employee_department")
}

// NEW — unit of measure for stocked materials
enum MaterialUnit {
  sheet
  kg
  litre
  roll
  piece

  @@map("material_unit")
}

// ── 1. User ─────────────────────────────────────────────────────────────

model User {
  uid       String   @id @default(uuid()) @db.Uuid
  uname     String
  email     String   @unique
  password  String?
  phoneNo   String   @unique
  role      UserRole @default(Customer)
  createdAt DateTime @default(now())

  addresses Address[]
  carts     Cart[]
  items     Item[]
  reviews   Reviews[]
  employee  Employee? // NEW — present only when role = Employee

  @@map("User")
}

// ── 2. Address ──────────────────────────────────────────────────────────

model Address {
  addressId    String  @id @default(uuid()) @db.Uuid
  userId       String  @db.Uuid
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  pincode      String
  country      String  @default("India")
  isDefault    Boolean @default(false)

  user User @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@index([userId])
  @@map("Address")
}

// ── 3. Category ─────────────────────────────────────────────────────────

model Category {
  categoryId   String  @id @default(uuid()) @db.Uuid
  categoryName String
  description  String?
  imageUrl     String?

  products Product[]

  @@map("Category")
}

// ── 4. Product ──────────────────────────────────────────────────────────

model Product {
  productId    String   @id @default(uuid()) @db.Uuid
  categoryId   String?  @db.Uuid
  productName  String
  description  String?
  productImage String?
  rating       Decimal  @default(0) @db.Decimal(2, 1)
  reviewCount  Int      @default(0)
  createdAt    DateTime @default(now())

  category Category?        @relation(fields: [categoryId], references: [categoryId], onDelete: SetNull)
  variants ProductVariant[]
  reviews  Reviews[]

  @@index([categoryId])
  @@map("Product")
}

// ── 5. ProductVariant ───────────────────────────────────────────────────

model ProductVariant {
  variantId String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  colour    String?
  size      String?
  price     Decimal @db.Decimal(10, 2)

  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)
  items   Item[]

  @@index([productId])
  @@map("ProductVariant")
}

// ── 6. Item ─────────────────────────────────────────────────────────────

model Item {
  itemId                 String   @id @default(uuid()) @db.Uuid
  userId                 String?  @db.Uuid
  variantId              String   @db.Uuid
  customizationLogoFront String?
  customizationLogoBack  String?
  unitPrice              Decimal  @db.Decimal(10, 2)
  quantity               Int      @default(1)
  createdAt              DateTime @default(now())

  user    User?          @relation(fields: [userId], references: [uid], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [variantId])

  @@index([userId])
  @@index([variantId])
  @@map("Item")
}

// ── 7. Cart ─────────────────────────────────────────────────────────────

model Cart {
  cartId    String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  sessionId String?
  itemIds   Json     @default("[]") @db.JsonB
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user   User?   @relation(fields: [userId], references: [uid], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("Cart")
}

// ── 8. Order ────────────────────────────────────────────────────────────

model Order {
  orderId     String      @id @default(uuid()) @db.Uuid
  cartId      String      @db.Uuid
  status      OrderStatus @default(pending)
  totalAmount Decimal     @db.Decimal(10, 2)

  cart     Cart      @relation(fields: [cartId], references: [cartId])
  payments Payment[]
  reviews  Reviews[]
  printJob PrintJob? // NEW — 1:1, the production job behind this order

  @@index([cartId])
  @@map("Order")
}

// ── 9. Payment ──────────────────────────────────────────────────────────
// onDelete changed from Cascade -> Restrict: a Payment is a financial
// record and should never silently disappear because its Order was
// deleted. Deleting an Order with payments now fails loudly instead.

model Payment {
  paymentId    String        @id @default(uuid()) @db.Uuid
  orderId      String        @db.Uuid
  paymentMode  String?
  gatewayTxnId String?
  status       PaymentStatus @default(initiated)
  amount       Decimal       @db.Decimal(10, 2)
  createdAt    DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [orderId], onDelete: Restrict)

  @@index([orderId])
  @@map("Payment")
}

// ── 10. Reviews ─────────────────────────────────────────────────────────

model Reviews {
  rid       String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  userId    String?  @db.Uuid
  orderId   String?  @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [uid], onDelete: SetNull)
  order   Order?  @relation(fields: [orderId], references: [orderId])

  @@index([productId])
  @@map("Reviews")
}

// ─────────────────────────────────────────────────────────────────────────
// NEW — Production / Inventory / Employee layer
// ─────────────────────────────────────────────────────────────────────────

// ── 11. Employee ────────────────────────────────────────────────────────
// 1:1 with User (auth stays unified — an Employee just has role=Employee
// on their User row, plus this row for staff-specific fields).

model Employee {
  employeeId   String             @id @default(uuid()) @db.Uuid
  userId       String             @unique @db.Uuid
  department   EmployeeDepartment @default(General)
  designation  String?
  isActive     Boolean            @default(true)
  joinedAt     DateTime           @default(now())

  user             User            @relation(fields: [userId], references: [uid], onDelete: Cascade)
  assignedJobs     PrintJob[]      @relation("AssignedEmployee")
  stageChangesMade JobStageHistory[]

  @@index([department])
  @@map("Employee")
}

// ── 12. PrintJob ────────────────────────────────────────────────────────
// One row per Order (1:1) — the internal production record. Order.status
// stays the coarse customer-facing state (pending/confirmed/shipped/...);
// PrintJob.stage is the finer-grained internal pipeline state that the
// Employee Panel moves through and the customer's tracking page reads.

model PrintJob {
  jobId                String          @id @default(uuid()) @db.Uuid
  orderId               String          @unique @db.Uuid
  assignedEmployeeId    String?         @db.Uuid
  stage                 ProductionStage @default(DesignReview)
  priority               String          @default("Standard") // "Standard" | "Urgent"
  notes                 String?
  estimatedCompletionAt DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime        @default(now())

  order            Order             @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  assignedEmployee Employee?         @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [employeeId], onDelete: SetNull)
  stageHistory     JobStageHistory[]
  materialUsage    MaterialUsage[]

  @@index([assignedEmployeeId])
  @@index([stage])
  @@map("PrintJob")
}

// ── 13. JobStageHistory ─────────────────────────────────────────────────
// Audit trail of every stage transition — this is what powers the
// customer-facing "Order Placed → Design Approved → Printing → ..."
// timeline, and gives you accountability for who moved a job and when.

model JobStageHistory {
  historyId       String          @id @default(uuid()) @db.Uuid
  jobId           String          @db.Uuid
  fromStage       ProductionStage?
  toStage         ProductionStage
  changedByEmployeeId String?     @db.Uuid
  note            String?
  changedAt       DateTime        @default(now())

  job             PrintJob  @relation(fields: [jobId], references: [jobId], onDelete: Cascade)
  changedByEmployee Employee? @relation(fields: [changedByEmployeeId], references: [employeeId], onDelete: SetNull)

  @@index([jobId])
  @@map("JobStageHistory")
}

// ── 14. Material ────────────────────────────────────────────────────────
// Stock of raw materials — paper, ink, plates, binding supplies, etc.

model Material {
  materialId        String       @id @default(uuid()) @db.Uuid
  name              String       @unique
  unit              MaterialUnit
  currentStock      Decimal      @default(0) @db.Decimal(12, 2)
  reorderThreshold  Decimal      @default(0) @db.Decimal(12, 2)
  unitCost          Decimal      @db.Decimal(10, 2)
  updatedAt         DateTime     @default(now()) @updatedAt

  usage MaterialUsage[]

  @@map("Material")
}

// ── 15. MaterialUsage ───────────────────────────────────────────────────
// One row per material consumption event on a job — this is what the
// Inventory Service deducts from Material.currentStock, and what lets
// you cost out a job after the fact.

model MaterialUsage {
  usageId      String   @id @default(uuid()) @db.Uuid
  jobId        String   @db.Uuid
  materialId   String   @db.Uuid
  quantityUsed Decimal  @db.Decimal(12, 2)
  usedAt       DateTime @default(now())

  job      PrintJob @relation(fields: [jobId], references: [jobId], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [materialId], onDelete: Restrict)

  @@index([jobId])
  @@index([materialId])
  @@map("MaterialUsage")
}

// ─────────────────────────────────────────────────────────────────────────
// Apply via raw SQL / migration after `prisma migrate dev`:
//
// 1. CHECK constraint: rating between 1 and 5 on Reviews (unchanged from v6).
// 2. Trigger to keep Product.rating / reviewCount in sync (unchanged from v6).
// 3. GIN index on Cart.itemIds (unchanged from v6):
//    create index idx_cart_itemids_gin on "Cart" using gin ("itemIds");
// 4. NEW — a trigger (or application-layer service call) that decrements
//    Material.currentStock whenever a MaterialUsage row is inserted, and
//    optionally raises a low-stock event when currentStock < reorderThreshold.
//    Keeping this as a trigger means stock can never drift out of sync
//    even if someone writes MaterialUsage rows outside the app.
// ─────────────────────────────────────────────────────────────────────────
